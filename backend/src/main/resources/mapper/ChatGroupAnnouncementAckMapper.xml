<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.community.mapper.ChatGroupAnnouncementAckMapper">

    <resultMap id="ChatGroupAnnouncementAckResultMap" type="com.community.entity.ChatGroupAnnouncementAck">
        <id property="id" column="id"/>
        <result property="groupId" column="group_id"/>
        <result property="userId" column="user_id"/>
        <result property="announcementVersion" column="announcement_version"/>
        <result property="ackedAt" column="acked_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.community.entity.ChatGroupAnnouncementAck" useGeneratedKeys="true" keyProperty="id">
        INSERT IGNORE INTO chat_group_announcement_ack (group_id, user_id, announcement_version)
        VALUES (#{groupId}, #{userId}, #{announcementVersion})
    </insert>

    <select id="selectByGroupUserVersion" resultMap="ChatGroupAnnouncementAckResultMap">
        SELECT id, group_id, user_id, announcement_version, acked_at
        FROM chat_group_announcement_ack
        WHERE group_id = #{groupId}
          AND user_id = #{userId}
          AND announcement_version = #{announcementVersion}
        LIMIT 1
    </select>

</mapper>
