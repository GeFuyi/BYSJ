<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.community.mapper.ServiceCategoryMapper">

    <resultMap id="CategoryResultMap" type="com.community.entity.ServiceCategory">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
    </resultMap>

    <select id="selectEnabled" resultMap="CategoryResultMap">
        SELECT id, code, name, sort, status
        FROM service_category
        WHERE status = 1
        ORDER BY sort ASC, id ASC
    </select>

    <select id="selectByCode" resultMap="CategoryResultMap">
        SELECT id, code, name, sort, status
        FROM service_category
        WHERE code = #{code}
        LIMIT 1
    </select>

</mapper>

