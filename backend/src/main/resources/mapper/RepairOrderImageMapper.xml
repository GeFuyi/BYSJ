<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.community.mapper.RepairOrderImageMapper">

    <resultMap id="RepairOrderImageResultMap" type="com.community.entity.RepairOrderImage">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="imagePath" column="image_path"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insertBatch">
        INSERT INTO repair_order_image (order_id, image_path)
        VALUES
        <foreach collection="imagePaths" item="path" separator=",">
            (#{orderId}, #{path})
        </foreach>
    </insert>

    <select id="selectByOrderId" resultMap="RepairOrderImageResultMap">
        SELECT id, order_id, image_path, created_at
        FROM repair_order_image
        WHERE order_id = #{orderId}
        ORDER BY id ASC
    </select>

</mapper>

