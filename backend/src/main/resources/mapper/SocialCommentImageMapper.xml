<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.community.mapper.SocialCommentImageMapper">

    <resultMap id="SocialCommentImageResultMap" type="com.community.entity.SocialCommentImage">
        <id property="id" column="id"/>
        <result property="commentId" column="comment_id"/>
        <result property="imagePath" column="image_path"/>
        <result property="sortNo" column="sort_no"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insertBatch">
        INSERT INTO social_comment_image (comment_id, image_path, sort_no)
        VALUES
        <foreach collection="imagePaths" item="path" index="index" separator=",">
            (#{commentId}, #{path}, #{index})
        </foreach>
    </insert>

    <select id="selectByCommentId" resultMap="SocialCommentImageResultMap">
        SELECT id, comment_id, image_path, sort_no, created_at
        FROM social_comment_image
        WHERE comment_id = #{commentId}
        ORDER BY sort_no ASC, id ASC
    </select>

    <select id="selectByCommentIds" resultMap="SocialCommentImageResultMap">
        SELECT id, comment_id, image_path, sort_no, created_at
        FROM social_comment_image
        WHERE comment_id IN
        <foreach collection="commentIds" item="commentId" open="(" close=")" separator=",">
            #{commentId}
        </foreach>
        ORDER BY comment_id ASC, sort_no ASC, id ASC
    </select>

</mapper>

