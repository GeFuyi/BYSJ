<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.community.mapper.SocialPostImageMapper">

    <resultMap id="SocialPostImageResultMap" type="com.community.entity.SocialPostImage">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="imagePath" column="image_path"/>
        <result property="sortNo" column="sort_no"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insertBatch">
        INSERT INTO social_post_image (post_id, image_path, sort_no)
        VALUES
        <foreach collection="imagePaths" item="path" index="index" separator=",">
            (#{postId}, #{path}, #{index})
        </foreach>
    </insert>

    <select id="selectByPostId" resultMap="SocialPostImageResultMap">
        SELECT id, post_id, image_path, sort_no, created_at
        FROM social_post_image
        WHERE post_id = #{postId}
        ORDER BY sort_no ASC, id ASC
    </select>

    <select id="selectByPostIds" resultMap="SocialPostImageResultMap">
        SELECT id, post_id, image_path, sort_no, created_at
        FROM social_post_image
        WHERE post_id IN
        <foreach collection="postIds" item="postId" open="(" close=")" separator=",">
            #{postId}
        </foreach>
        ORDER BY post_id DESC, sort_no ASC, id ASC
    </select>

</mapper>

