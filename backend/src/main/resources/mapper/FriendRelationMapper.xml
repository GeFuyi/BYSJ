<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.community.mapper.FriendRelationMapper">

    <resultMap id="FriendRelationResultMap" type="com.community.entity.FriendRelation">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="friendId" column="friend_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.community.entity.FriendRelation" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO friend_relation (user_id, friend_id)
        VALUES (#{userId}, #{friendId})
    </insert>

    <select id="selectByUserAndFriend" resultMap="FriendRelationResultMap">
        SELECT id, user_id, friend_id, created_at
        FROM friend_relation
        WHERE user_id = #{userId}
          AND friend_id = #{friendId}
        LIMIT 1
    </select>

    <select id="selectByUserId" resultMap="FriendRelationResultMap">
        SELECT id, user_id, friend_id, created_at
        FROM friend_relation
        WHERE user_id = #{userId}
        ORDER BY id DESC
    </select>

    <delete id="deleteByUserAndFriend">
        DELETE FROM friend_relation
        WHERE user_id = #{userId}
          AND friend_id = #{friendId}
    </delete>

</mapper>
